// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
//  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ShoppingItem {
  id  String  @id @default(uuid())
  name  String 
  category  String?
  requiredCount Int @default(1) @map("required_count")
  currentCount  Int @default(0) @map("current_count")
  amazonUrl String? @map("amazon_url")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("shopping_items")
}

model User {
  id  String  @id
  email String  @unique
  name  String?
  createdAt DateTime  @default(now()) @map("created_at")
  mealPlans MealPlan[]
  assignedTasks Task[]          @relation("AssignedTasks")
  createdTasks  Task[]          @relation("CreatedTasks")

  @@map("users")
}

// 1回の生成リクエスト（例: 3日分・2人前）
model MealPlan {
  id            String          @id @default(uuid())
  userId        String?
  user          User?           @relation(fields: [userId], references: [id])
  servings      Int             // 作る人数
  days          Int             // 作る日数
  inputIngredients String[]     // ユーザーが入力した食材
  totalIngredients Json?    @map("total_ingredients")
  created_at    DateTime        @default(now())
  
  dailyMeals    DailyMeal[]     // 日ごとの献立

  @@map("meal_plans")
}

// 各日の献立データ
model DailyMeal {
  id            String          @id @default(uuid())
  mealPlanId    String
  mealPlan      MealPlan        @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dayNumber     Int             // 1日目, 2日目...
  title         String          // 料理名（例: 豚肉とキャベツの味噌炒め）
  description   String?         // 簡単な特徴・アピールポイント
  cookingTimeMinutes Int?       // 調理時間
  ingredients   Json            // 使用食材（[{name: "豚肉", amount: "200g", isInputItem: true}]）
  steps         String[]        // 調理手順
  advice        String?         // コツ・保存方法・余った場合の応用
  
}

// 1. 家事タスク（家族全員で共有）
model Task {
  id          String    @id @default(uuid())
  title       String    // 例: "可燃ごみ出し", "お風呂掃除"
  category    String    // "cleaning", "trash", "laundry", "other"
  status      String    @default("todo") // "todo", "done"
  
  // 担当者・作成者（誰のタスクか判別したい場合のみ使用）
  assigneeId  String?
  assignee    User?     @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdById String?
  createdBy   User?     @relation("CreatedTasks", fields: [createdById], references: [id])

  dueDate     DateTime? // 期限日
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("tasks")
}

// 2. 日用品ストック・買出しリスト（家族全員で共有）
model InventoryItem {
  id        String   @id @default(uuid())
  name      String   // 例: "トイレットペーパー", "食器用洗剤"
  status    String   @default("ok") // "ok" (在庫あり), "low" (そろそろ), "empty" (買い出し必要)
  category  String   // "sanitary", "kitchen", "daily"
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("inventory_items")
}